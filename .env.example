# Copy to .env for Docker Compose. Never commit actual secrets.
PUBLIC_HOST=keran.example.org
DEBUG=0
ALLOWED_HOSTS=keran.example.org
CSRF_TRUSTED_ORIGINS=https://keran.example.org
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
WEBHOOK_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
PAYMENT_MODE=sandbox
REQUIRE_STAFF_MFA=1
# Optional PostgreSQL; default is a persistent SQLite file in DATA_DIR.
# POSTGRES_DB=keran
# POSTGRES_USER=keran
# POSTGRES_PASSWORD=
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
